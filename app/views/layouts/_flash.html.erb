<%# Toasts, not a banner: fixed to the viewport so a flash never reflows the
    page under it. Text stays in the initial DOM for screen readers and tests. %>
<%
  toasts = [
    [ notice, "text-emerald-600 dark:text-emerald-400",
      %(<path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm3.844-8.791a.75.75 0 0 0-1.188-.918l-3.7 4.79-1.649-1.833a.75.75 0 1 0-1.114 1.004l2.25 2.5a.75.75 0 0 0 1.15-.043l4.25-5.5Z" clip-rule="evenodd"/>),
      { role: "status", "aria-live": "polite" } ],
    [ alert, "text-red-600 dark:text-red-400",
      %(<path fill-rule="evenodd" d="M6.701 2.25c.577-1 2.02-1 2.598 0l5.196 9a1.5 1.5 0 0 1-1.299 2.25H2.804a1.5 1.5 0 0 1-1.3-2.25l5.197-9ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 1 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/>),
      { role: "alert" } ]
  ].select { |message,| message.present? }
%>
<% if toasts.any? %>
  <div class="toast-stack pointer-events-none fixed inset-x-4 bottom-4 z-30 flex flex-col items-center space-y-2 sm:inset-x-auto sm:right-6 sm:items-end">
    <% toasts.each do |message, icon_color, icon, aria| %>
      <div data-controller="toast" data-action="mouseenter->toast#pause mouseleave->toast#resume"
           <%= tag.attributes(aria) %>
           class="pointer-events-auto flex w-full max-w-sm items-center gap-2.5 rounded-lg surface p-3 pr-2.5 shadow-lg transition duration-150 ease-out-quart inset-ring inset-ring-neutral-950/10 motion-reduce:transition-none dark:shadow-none dark:inset-ring-white/10">
        <svg viewBox="0 0 16 16" class="size-4 shrink-0 fill-current <%= icon_color %>" aria-hidden="true"><%= icon.html_safe %></svg>
        <p class="min-w-0 grow text-sm text-neutral-950 dark:text-white"><%= message %></p>
        <button type="button" aria-label="Dismiss" data-action="toast#dismiss"
                class="relative flex size-6 shrink-0 cursor-pointer items-center justify-center rounded text-neutral-500 transition-colors duration-150 before:absolute before:-inset-2.5 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white">
          <svg viewBox="0 0 16 16" class="size-4 fill-current" aria-hidden="true">
            <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z"/>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
