<!DOCTYPE html>
<html class="antialiased">
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# Default text color lives here so bare elements (dd, h1 without a class)
      inherit something readable in both modes instead of browser black. %>
  <body class="canvas text-neutral-950 dark:text-white">
    <% if current_user %>
      <div class="min-h-dvh lg:flex">
        <%= render settings_area? ? "layouts/settings_sidebar" : "layouts/sidebar" %>
        <div class="min-w-0 flex-1">
          <%= render "layouts/mobile_nav" %>
          <main class="isolate mx-auto max-w-7xl px-5 py-10 lg:px-8 lg:py-12">
            <%= render "layouts/flash" %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <%# Signed-out pages are single, self-contained cards, so the branch does
          the centring rather than every page repeating it. %>
      <main class="isolate mx-auto grid min-h-dvh max-w-7xl place-items-center px-5 py-10">
        <div class="w-full max-w-sm">
          <%= render "layouts/flash" %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body>
</html>
