<% content_for :title, "Sign in" %>
<div class="<%= ui(:card) %> px-6 py-8 text-center sm:px-8">
  <%= render "shared/logo_mark", class: "mx-auto size-8 text-oxblood-700 dark:text-oxblood-500" %>
  <h1 class="mt-5 <%= ui(:heading) %>">Sign in to Hookrail</h1>
  <p class="mt-2 text-base/6 text-pretty text-neutral-500 sm:text-sm/6 dark:text-neutral-400">
    Inspect deliveries, replay events, and wire up new destinations.
  </p>

  <%# data-turbo=false: OAuth needs a full-page redirect to github.com; Turbo's fetch can't follow cross-origin. %>
  <%= button_to "/auth/github", method: :post, data: { turbo: false },
        class: "mt-6 flex w-full cursor-pointer items-center justify-center gap-2 rounded-md bg-neutral-950 px-3 py-2.5 text-base/6 font-medium text-white transition-colors duration-150 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 sm:py-2 sm:text-sm/6 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200 dark:focus-visible:outline-white" do %>
    <svg viewBox="0 0 16 16" class="size-4 shrink-0 fill-current" aria-hidden="true">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
    </svg>
    Continue with GitHub
  <% end %>
</div>

<p class="mt-4 text-center text-base/6 text-pretty text-neutral-500 sm:text-sm/6 dark:text-neutral-400">
  Hookrail reads only your GitHub profile and email address.
</p>
