<% content_for :title, "Authorize CLI" %>
<div>
  <h1 class="mb-6 <%= ui(:heading) %>">Authorize CLI</h1>

  <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-6">
    This grants the CLI access to <%= Current.organization.name %> with your role.
  </p>

  <% if @authorization %>
    <div class="mb-6 space-y-3 rounded-lg px-3 py-3 inset-ring inset-ring-neutral-950/10 dark:inset-ring-white/10">
      <div>
        <span class="block text-xs font-medium text-neutral-500 dark:text-neutral-400">Device</span>
        <span class="block text-sm"><%= @authorization.device_name %></span>
      </div>
      <div>
        <span class="block text-xs font-medium text-neutral-500 dark:text-neutral-400">Code</span>
        <span class="block font-mono text-lg"><%= @authorization.user_code %></span>
      </div>
    </div>

    <%= form_with url: cli_authorize_path, method: :post, class: "flex items-center gap-2" do %>
      <%= hidden_field_tag :code, @authorization.user_code %>
      <%= button_tag "Approve", name: "decision", value: "approve",
            class: ui(:button_primary) %>
      <%= button_tag "Deny", name: "decision", value: "deny",
            class: ui(:button_secondary) %>
    <% end %>
  <% else %>
    <%= form_with url: cli_authorize_path, method: :post, class: "flex items-center gap-2" do %>
      <%= text_field_tag :code, @code, placeholder: "XXXX-XXXX",
            class: "#{ui(:input)} w-40 font-mono uppercase" %>
      <%= submit_tag "Continue", class: ui(:button_primary) %>
    <% end %>
  <% end %>
</div>
