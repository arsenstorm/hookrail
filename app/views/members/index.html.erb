<% content_for :title, "Organization settings · Members" %>
<%
  field_label = "mb-1 block text-xs font-medium text-neutral-500 dark:text-neutral-400"
%>
<div>
  <div data-controller="dialog">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="<%= ui(:heading) %>">Members</h1>
      <button type="button" data-action="dialog#open" class="<%= ui(:button_primary) %>">Invite someone</button>
    </div>

    <dialog data-dialog-target="dialog" aria-labelledby="invite-heading"
            class="m-auto w-full max-w-md rounded-xl p-5 elevated backdrop:bg-neutral-950/40 dark:backdrop:bg-neutral-950/60">
      <h2 id="invite-heading" class="<%= ui(:subheading) %>">Invite someone</h2>
      <%= form_with url: invitations_path, scope: :invitation, class: "mt-4" do |f| %>
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="sm:col-span-3">
            <%= f.label :email, "Email", class: ui(:label) %>
            <%= f.email_field :email, placeholder: "teammate@example.com", required: true, autofocus: true,
                  class: "#{ui(:input)} mt-1.5" %>
          </div>
          <div>
            <%= f.label :role, "Role", class: ui(:label) %>
            <span class="relative mt-1.5 flex">
              <%= f.select :role, [ %w[Member member], %w[Admin admin] ], {}, class: "#{ui(:select)} w-full" %>
              <%= render "shared/select_chevron" %>
            </span>
          </div>
          <div>
            <%= f.label :project_id, "Project", class: ui(:label) %>
            <span class="relative mt-1.5 flex">
              <%= f.select :project_id, @projects.map { |p| [ p.name, p.id ] }, { include_blank: "None" },
                    class: "#{ui(:select)} w-full" %>
              <%= render "shared/select_chevron" %>
            </span>
          </div>
          <div>
            <%= f.label :level, "Access", class: ui(:label) %>
            <span class="relative mt-1.5 flex">
              <%= f.select :level, [ [ "No access", "" ], %w[Viewer viewer], %w[Editor editor] ], {},
                    class: "#{ui(:select)} w-full" %>
              <%= render "shared/select_chevron" %>
            </span>
          </div>
        </div>
        <p class="mt-3 <%= ui(:hint) %>">
          No email is sent. Copy the link from the pending list and send it yourself. The invitee's GitHub
          account email must match the address here, and the link expires after 7 days.
        </p>
        <div class="mt-5 flex justify-end gap-3">
          <button type="button" data-action="dialog#close" class="<%= ui(:button_secondary) %>">Cancel</button>
          <%= f.submit "Create invitation", name: nil, class: ui(:button_primary) %>
        </div>
      <% end %>
    </dialog>
  </div>

  <p class="mt-1 max-w-2xl <%= ui(:hint) %>">
    One owner runs the org. Admins do everything but hand over ownership, and both see every project.
    Members see only the projects granted to them below, either as a viewer (read-only) or an editor.
  </p>

  <div class="mt-6 <%= ui(:scroller) %>">
    <div class="<%= ui(:scroller_inner) %>">
      <table class="w-full text-sm">
        <thead class="<%= ui(:table_head) %>">
          <tr>
            <th class="<%= ui(:th) %> w-full pr-6">Member</th>
            <th class="<%= ui(:th) %> w-px pr-6">Role and project access</th>
            <th class="<%= ui(:th) %> w-px text-right"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="<%= ui(:table_body) %>">
          <% @memberships.each do |m| %>
            <tr class="align-top">
              <td class="<%= ui(:td) %> w-full pr-6">
                <span class="block font-medium"><%= m.user.github_login %></span>
                <span class="block text-xs text-neutral-500 dark:text-neutral-400"><%= m.user.name.presence || m.user.email %></span>
              </td>
              <td class="<%= ui(:td) %> w-px pr-6">
                <% if m.owner? %>
                  <span class="<%= ui(:badge) %> <%= ui(:badge_neutral) %>">owner</span>
                <% else %>
                  <%= form_with url: member_path(m), method: :patch, class: "flex flex-wrap items-end gap-3" do %>
                    <%# Ids are per-membership: the same fields repeat on every row. %>
                    <div>
                      <%= label_tag "role-#{m.id}", "Role", class: field_label %>
                      <span class="relative flex">
                        <%= select_tag "membership[role]",
                              options_for_select([ %w[Admin admin], %w[Member member] ], m.role),
                              id: "role-#{m.id}", class: ui(:select) %>
                        <%= render "shared/select_chevron" %>
                      </span>
                    </div>
                    <% @projects.each do |project| %>
                      <div>
                        <%= label_tag "grant-#{m.id}-#{project.id}", project.name, class: field_label %>
                        <span class="relative flex">
                          <%= select_tag "membership[grants][#{project.id}]",
                                options_for_select([ [ "No access", "" ], %w[Viewer viewer], %w[Editor editor] ],
                                                   m.project_grants.find { |g| g.project_id == project.id }&.level),
                                id: "grant-#{m.id}-#{project.id}", class: ui(:select) %>
                          <%= render "shared/select_chevron" %>
                        </span>
                      </div>
                    <% end %>
                    <%= submit_tag "Save", name: nil, class: ui(:button_primary) %>
                  <% end %>
                <% end %>
              </td>
              <td class="<%= ui(:td) %> w-px text-right">
                <% unless m.owner? %>
                  <div class="flex items-center justify-end gap-2">
                    <% if Current.membership.owner? && m.id != Current.membership.id %>
                      <%= button_to "Make owner", transfer_ownership_member_path(m),
                            class: ui(:button_secondary), form: { class: "inline" },
                            data: { turbo_confirm: "Hand the org over to #{m.user.github_login}? " \
                                                   "You drop to admin and can't take ownership back yourself." } %>
                    <% end %>
                    <%= button_to "Remove", member_path(m), method: :delete,
                          class: ui(:button_danger), form: { class: "inline" },
                          data: { turbo_confirm: "Remove #{m.user.github_login} from this org?" } %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <p class="mt-3 <%= ui(:hint) %>">Project access applies to members only. Admins see every project.</p>

  <section class="mt-10">
    <h2 class="<%= ui(:section) %>">Pending invitations</h2>
    <% if @invitations.empty? %>
      <p class="mt-2 <%= ui(:hint) %>">No pending invitations.</p>
    <% else %>
      <div class="mt-3 space-y-3">
        <% @invitations.each do |inv| %>
          <div class="rounded-xl p-4 inset-ring inset-ring-neutral-950/10 dark:inset-ring-white/10">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="text-sm">
                <span class="font-medium"><%= inv.email %></span>
                <span class="text-neutral-500 dark:text-neutral-400">
                  as <%= inv.role %> ·
                  <% if inv.expired? %>
                    expired
                  <% else %>
                    expires in <%= distance_of_time_in_words(Time.current, inv.created_at + Invitation::EXPIRY) %>
                  <% end %>
                </span>
              </p>
              <%= button_to "Revoke", invitation_path(inv), method: :delete,
                    class: ui(:button_danger), form: { class: "inline" },
                    data: { turbo_confirm: "Revoke this invitation? The link stops working immediately." } %>
            </div>
            <div class="mt-3 rounded-lg bg-neutral-950/5 px-3 py-2 font-mono text-xs break-all select-all inset-ring inset-ring-neutral-950/10 dark:bg-white/5 dark:inset-ring-white/10">
              <%= invite_url(inv.token) %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
