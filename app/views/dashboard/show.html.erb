<% content_for :full_bleed, "true" %>
<%
  other_org_memberships = Current.user.memberships.includes(:organization)
                                 .reject { |m| m.organization_id == Current.organization&.id }
  accessible = Current.membership&.accessible_projects.to_a

  nav_sections = []
  if Current.project
    nav_sections << [ "Monitor", [ [ "Dashboard", root_path, true ], [ "Events", events_path, false ], [ "Issues", issues_path, false ] ] ]
    nav_sections << [ "Configure", [ [ "Sources", sources_path, false ], [ "Destinations", destinations_path, false ], [ "Connections", connections_path, false ] ] ]
  end
  if Current.membership&.admin_or_owner?
    nav_sections << [ "Organization", [ [ "Projects", projects_path, false ], [ "Members", members_path, false ], [ "API keys", api_keys_path, false ], [ "Alerts", alert_webhook_path, false ], [ "Data retention", retention_path, false ] ] ]
  end

  nav_item_classes = ->(active) {
    base = "flex rounded-md px-2.5 py-1.5 text-sm font-medium"
    active ? "#{base} bg-oxblood-700/10 text-oxblood-900 dark:bg-oxblood-500/15 dark:text-oxblood-200" :
             "#{base} text-neutral-600 transition-colors duration-150 ease-out hover:bg-neutral-950/5 hover:text-neutral-950 dark:text-neutral-400 dark:hover:bg-white/5 dark:hover:text-white"
  }
%>

<div class="min-h-dvh canvas lg:flex">
  <aside class="w-64 shrink-0 flex-col border-r border-neutral-950/10 surface px-4 pt-6 pb-4 max-lg:hidden lg:flex dark:border-white/10">
    <a href="/" aria-label="Homepage" class="flex items-center gap-2 px-2.5">
      <%= render "shared/logo_mark", class: "size-6 shrink-0 text-oxblood-700 dark:text-oxblood-500" %>
      <span class="text-sm font-semibold text-neutral-950 dark:text-white">Hookrail</span>
    </a>

    <details class="group relative mt-5" data-controller="dismiss">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-lg px-2.5 py-1.5 transition-colors duration-150 ease-out inset-ring inset-ring-neutral-950/10 group-open:bg-neutral-950/5 hover:bg-neutral-950/5 [&::-webkit-details-marker]:hidden dark:inset-ring-white/10 dark:group-open:bg-white/5 dark:hover:bg-white/5">
        <span class="min-w-0">
          <span class="block truncate text-sm font-medium text-neutral-950 dark:text-white"><%= Current.project&.name || "No project" %></span>
          <span class="block truncate text-xs text-neutral-500 dark:text-neutral-400"><%= Current.organization&.name %></span>
        </span>
        <svg viewBox="0 0 16 16" class="size-4 shrink-0 fill-neutral-400" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.22 10.22a.75.75 0 0 1 1.06 0L8 11.94l1.72-1.72a.75.75 0 1 1 1.06 1.06l-2.25 2.25a.75.75 0 0 1-1.06 0l-2.25-2.25a.75.75 0 0 1 0-1.06Zm5.56-4.44a.75.75 0 0 1-1.06 0L8 4.06 6.28 5.78a.75.75 0 0 1-1.06-1.06l2.25-2.25a.75.75 0 0 1 1.06 0l2.25 2.25a.75.75 0 0 1 0 1.06Z" clip-rule="evenodd"/>
        </svg>
      </summary>
      <div class="absolute z-10 mt-1 w-full rounded-lg surface p-1 shadow-lg inset-ring inset-ring-neutral-950/10 dark:shadow-none dark:inset-ring-white/10">
        <% accessible.each do |project| %>
          <% if project.id == Current.project&.id %>
            <span class="flex rounded-sm bg-neutral-950/5 px-2.5 py-1.5 text-sm font-medium text-neutral-950 dark:bg-white/5 dark:text-white"><%= project.name %></span>
          <% else %>
            <%= button_to project.name, switch_project_path(project.id),
                  class: "flex w-full cursor-pointer rounded-sm px-2.5 py-1.5 text-left text-sm font-medium text-neutral-600 transition-colors duration-150 ease-out hover:bg-neutral-950/5 hover:text-neutral-950 dark:text-neutral-400 dark:hover:bg-white/5 dark:hover:text-white" %>
          <% end %>
        <% end %>
        <% if other_org_memberships.any? %>
          <div class="mx-2.5 my-1 border-t border-neutral-950/5 dark:border-white/5"></div>
          <% other_org_memberships.each do |m| %>
            <%= button_to "Switch to #{m.organization.name}", switch_org_path(m.organization_id),
                  class: "flex w-full cursor-pointer rounded-sm px-2.5 py-1.5 text-left text-sm font-medium text-neutral-600 transition-colors duration-150 ease-out hover:bg-neutral-950/5 hover:text-neutral-950 dark:text-neutral-400 dark:hover:bg-white/5 dark:hover:text-white" %>
          <% end %>
        <% end %>
      </div>
    </details>

    <nav class="mt-6 flex-1 space-y-6">
      <% nav_sections.each do |label, items| %>
        <div>
          <p class="px-2.5 text-xs font-medium text-neutral-500 dark:text-neutral-400"><%= label %></p>
          <ul role="list" class="mt-1.5 space-y-0.5">
            <% items.each do |name, path, active| %>
              <li><%= link_to name, path, class: nav_item_classes.call(active) %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </nav>

    <div class="mt-6 border-t border-neutral-950/10 pt-2 dark:border-white/10">
      <%= render "shared/user_menu" %>
    </div>
  </aside>

  <div class="min-w-0 flex-1">
    <header class="border-b border-neutral-950/10 surface lg:hidden dark:border-white/10">
      <details data-controller="dismiss">
        <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 [&::-webkit-details-marker]:hidden">
          <span class="flex items-center gap-2">
            <%= render "shared/logo_mark", class: "size-6 shrink-0 text-oxblood-700 dark:text-oxblood-500" %>
            <span class="text-sm font-semibold text-neutral-950 dark:text-white">Hookrail</span>
          </span>
          <span class="relative">
            <span class="sr-only">Open navigation</span>
            <svg viewBox="0 0 16 16" class="size-4 fill-neutral-600 dark:fill-neutral-400" aria-hidden="true">
              <path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h10.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75ZM2 8a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 8Zm0 3.25a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd"/>
            </svg>
            <span class="absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2 pointer-fine:hidden" aria-hidden="true"></span>
          </span>
        </summary>
        <nav class="space-y-6 border-t border-neutral-950/10 px-5 py-4 dark:border-white/10">
          <% nav_sections.each do |label, items| %>
            <div>
              <p class="px-2.5 text-xs font-medium text-neutral-500 dark:text-neutral-400"><%= label %></p>
              <ul role="list" class="mt-1.5 space-y-0.5">
                <% items.each do |name, path, active| %>
                  <li><%= link_to name, path, class: nav_item_classes.call(active) %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div class="border-t border-neutral-950/10 pt-2 dark:border-white/10">
            <%= render "shared/user_menu", drop: "down" %>
          </div>
        </nav>
      </details>
    </header>

    <div class="mx-auto max-w-7xl px-5 py-10 lg:px-8 lg:py-12">
      <% if Current.project.nil? %>
        <h1 class="text-2xl font-semibold tracking-tight text-balance text-neutral-950 dark:text-white">Dashboard</h1>
        <p class="mt-3 max-w-lg text-sm text-neutral-500 dark:text-neutral-400">
          No project access in this org yet — an admin has to grant you one before events, sources,
          and destinations show up here.
        </p>
      <% else %>
        <%= render "dashboard/overview" %>
      <% end %>
    </div>
  </div>
</div>
