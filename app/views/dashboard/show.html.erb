<div class="mx-auto max-w-2xl py-16">
  <h1 class="text-2xl font-semibold mb-2">Hookrail</h1>
  <p class="text-gray-600 mb-4">
    Signed in as <%= current_user.github_login %>
    &middot; org <%= Current.organization&.name %>
    &middot; project <%= Current.project&.name %>
  </p>
  <p class="mb-8">
    <%= link_to "View events →", events_path, class: "text-blue-600 hover:underline" %>
  </p>
  <%= button_to "Sign out", logout_path, method: :delete,
        class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50" %>
</div>
