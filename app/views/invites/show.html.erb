<% content_for :title, "Accept invitation" %>
<div class="<%= ui(:card) %> px-6 py-8 text-center sm:px-8">
  <%= render "shared/logo_mark", class: "mx-auto size-8 text-oxblood-700 dark:text-oxblood-500" %>
  <h1 class="mt-5 <%= ui(:heading) %>">Join <%= @invitation.organization.name %>?</h1>
  <p class="mt-2 text-base/6 text-pretty text-neutral-500 sm:text-sm/6 dark:text-neutral-400">
    You were invited as <%= @invitation.role %>. Accepting adds you to this organization
    and makes it your active one.
  </p>

  <%= button_to "Accept invitation", invite_path(@invitation.token),
        class: "mt-6 flex w-full cursor-pointer items-center justify-center gap-2 rounded-md bg-neutral-950 px-3 py-2.5 text-base/6 font-medium text-white transition-colors duration-150 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 sm:py-2 sm:text-sm/6 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200 dark:focus-visible:outline-white" %>

  <%= link_to "Not now", dashboard_path, class: "mt-3 inline-block text-base/6 text-neutral-500 underline underline-offset-2 sm:text-sm/6 dark:text-neutral-400" %>
</div>
