<% content_for :title, "Organization settings · Alerts" %>
<% organization = Current.organization %>
<div>
  <h1 class="<%= ui(:heading) %>">Alerts</h1>
  <p class="mt-1 max-w-2xl <%= ui(:hint) %>">
    The three incident alerts that go out by email also POST signed JSON to a webhook. Point your chat or
    incident tooling at it to get them without watching an inbox.
  </p>

  <div class="mt-6 max-w-2xl rounded-xl p-4 inset-ring inset-ring-neutral-950/10 dark:inset-ring-white/10">
    <%= form_with model: organization, url: alert_webhook_path, method: :patch, scope: :organization do |f| %>
      <% if organization.errors.any? %>
        <div class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800 inset-ring inset-ring-red-600/20 dark:bg-red-950/40 dark:text-red-200 dark:inset-ring-red-400/25">
          <ul class="list-inside list-disc">
            <% organization.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid gap-4">
        <div>
          <%= f.label :alert_webhook_url, "Webhook URL", class: ui(:label) %>
          <%= f.text_field :alert_webhook_url, placeholder: "https://hooks.example.com/hookrail",
                class: "#{ui(:input)} mt-1.5 font-mono" %>
          <p class="mt-1.5 <%= ui(:hint) %>">Signed JSON, one POST per alert.</p>
        </div>

        <div class="border-t border-neutral-950/10 pt-4 dark:border-white/10">
          <h2 class="<%= ui(:section) %>">Chat notifications</h2>
          <p class="mt-1 <%= ui(:hint) %>">
            Posted when a new issue opens — delivery failures, transformation errors, quarantined webhooks.
            Repeats of an open issue don't re-notify.
          </p>
          <div class="mt-3 grid gap-4">
            <div>
              <%= f.label :slack_webhook_url, "Slack incoming webhook URL", class: ui(:label) %>
              <%= f.text_field :slack_webhook_url, placeholder: "https://hooks.slack.com/services/…",
                    class: "#{ui(:input)} mt-1.5 font-mono" %>
            </div>
            <div>
              <%= f.label :discord_webhook_url, "Discord webhook URL", class: ui(:label) %>
              <%= f.text_field :discord_webhook_url, placeholder: "https://discord.com/api/webhooks/…",
                    class: "#{ui(:input)} mt-1.5 font-mono" %>
            </div>
          </div>
        </div>
      </div>

      <%= f.submit "Save", class: "#{ui(:button_primary)} mt-4" %>
    <% end %>
  </div>

  <% if organization.alert_webhook_configured? || organization.chat_webhook_configured? %>
    <div class="mt-4 flex max-w-2xl flex-wrap items-center gap-2">
      <%= button_to "Send test alert", test_alert_webhook_path, class: ui(:button_secondary) %>
      <% if organization.alert_webhook_configured? %>
        <%= button_to "Remove", alert_webhook_path, method: :delete,
              class: ui(:button_danger),
              data: { turbo_confirm: "Remove the alert webhook? The signing secret is discarded with it." } %>
      <% end %>
    </div>
  <% end %>

  <% if organization.alert_webhook_configured? %>
    <section class="mt-10 max-w-2xl">
      <h2 class="<%= ui(:section) %>">Signing secret</h2>
      <div class="mt-2 rounded-lg bg-neutral-950/5 px-3 py-2 font-mono text-sm break-all select-all inset-ring inset-ring-neutral-950/10 dark:bg-white/5 dark:inset-ring-white/10">
        <%= organization.alert_webhook_secret %>
      </div>
      <p class="mt-2 <%= ui(:hint) %>">
        Verify <code>X-Hookrail-Signature</code> as the HMAC-SHA256 of <code>"timestamp.body"</code> with this
        secret — the same scheme as event deliveries, see the README.
      </p>
    </section>
  <% end %>

  <section class="mt-10 max-w-2xl">
    <h2 class="<%= ui(:section) %>">Alert types</h2>
    <div class="mt-2 <%= ui(:scroller) %>">
      <div class="<%= ui(:scroller_inner) %>">
        <table class="w-full text-sm">
          <thead class="<%= ui(:table_head) %>">
            <tr>
              <th class="<%= ui(:th) %> w-px pr-6">Type</th>
              <th class="<%= ui(:th) %> w-full">Sent when</th>
            </tr>
          </thead>
          <tbody class="<%= ui(:table_body) %>">
            <% {
                 "connection.unhealthy" => "A connection crossed its consecutive-failure threshold.",
                 "connection.recovered" => "An unhealthy connection delivered successfully again.",
                 "webhook.quarantined" => "An inbound webhook failed signature verification.",
                 "test" => "You hit Send test alert."
               }.each do |type, when_sent| %>
              <tr>
                <td class="<%= ui(:td) %> w-px pr-6 font-mono text-xs"><%= type %></td>
                <td class="<%= ui(:td_muted) %> w-full"><%= when_sent %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>
