<%# One dialog per channel, opened by both the configured row's Edit link and
    the "Add a channel" card — so the markup lives here once. %>
<dialog data-dialog-target="dialog" aria-labelledby="<%= channel[:key] %>-channel-heading"
        class="m-auto w-full max-w-md rounded-xl p-5 elevated backdrop:bg-neutral-950/40 dark:backdrop:bg-neutral-950/60">
  <h2 id="<%= channel[:key] %>-channel-heading" class="<%= ui(:subheading) %>"><%= channel[:name] %> channel</h2>
  <%= form_with model: organization, url: alert_webhook_path, method: :patch, scope: :organization, class: "mt-4" do |f| %>
    <% errors = organization.errors[channel[:attribute]] %>
    <% if errors.any? %>
      <div class="mb-3 rounded-lg bg-red-50 p-3 text-sm text-red-800 inset-ring inset-ring-red-600/20 dark:bg-red-950/40 dark:text-red-200 dark:inset-ring-red-400/25">
        <ul class="list-inside list-disc">
          <% errors.each do |message| %><li><%= organization.errors.full_message(channel[:attribute], message) %></li><% end %>
        </ul>
      </div>
    <% end %>
    <%= f.label channel[:attribute], "#{channel[:name]} URL", class: ui(:label) %>
    <%= f.text_field channel[:attribute], placeholder: channel[:placeholder], autofocus: true,
          class: "#{ui(:input)} mt-1.5 font-mono" %>
    <p class="mt-1.5 <%= ui(:hint) %>"><%= channel[:hint] %></p>
    <div class="mt-5 flex justify-end gap-3">
      <button type="button" data-action="dialog#close" class="<%= ui(:button_secondary) %>">Cancel</button>
      <%= f.submit "Save", class: ui(:button_primary) %>
    </div>
  <% end %>
</dialog>
