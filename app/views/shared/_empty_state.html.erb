<%# Empty-state card. Locals: title, body, cta_label, cta_path. %>
<div class="rounded-xl px-6 py-12 text-center inset-ring inset-ring-neutral-950/10 dark:inset-ring-white/10">
  <h2 class="<%= ui(:subheading) %>"><%= title %></h2>
  <p class="mx-auto mt-1 max-w-sm <%= ui(:hint) %>"><%= body %></p>
  <% if can_edit? %>
    <%= link_to cta_label, cta_path, class: "#{ui(:button_primary)} mt-5" %>
  <% else %>
    <p class="mt-5 <%= ui(:hint) %>">Ask a project editor to add one.</p>
  <% end %>
</div>
