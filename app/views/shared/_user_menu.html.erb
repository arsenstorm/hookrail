<%
  # `drop` is "up" in the sidebar (the footer sits at the bottom) and "down" in
  # the mobile nav, where the menu is inline.
  drop = local_assigns.fetch(:drop, "up")
  panel_position = drop == "up" ? "bottom-full mb-1" : "top-full mt-1"
  item = "flex w-full cursor-pointer rounded-sm px-2.5 py-1.5 text-left text-sm font-medium text-neutral-600 transition-colors duration-150 ease-out hover:bg-neutral-950/5 hover:text-neutral-950 dark:text-neutral-400 dark:hover:bg-white/5 dark:hover:text-white"
%>
<details class="group relative" data-controller="dismiss">
  <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md px-2.5 py-2 transition-colors duration-150 ease-out group-open:bg-neutral-950/5 hover:bg-neutral-950/5 [&::-webkit-details-marker]:hidden dark:group-open:bg-white/5 dark:hover:bg-white/5">
    <% if current_user.avatar_url.present? %>
      <img src="<%= current_user.avatar_url %>" alt="" width="32" height="32"
           class="size-8 shrink-0 rounded-full -outline-offset-1 outline-1 outline-black/10 dark:outline-white/10">
    <% else %>
      <span class="grid size-8 shrink-0 place-items-center rounded-full bg-neutral-950/5 text-xs font-semibold text-neutral-600 dark:bg-white/10 dark:text-neutral-300" aria-hidden="true">
        <%= (current_user.name.presence || current_user.github_login).first.upcase %>
      </span>
    <% end %>
    <span class="min-w-0 flex-1">
      <span class="block truncate text-sm font-medium text-neutral-950 dark:text-white"><%= current_user.name.presence || current_user.github_login %></span>
      <span class="block truncate text-xs text-neutral-500 dark:text-neutral-400"><%= current_user.github_login %></span>
    </span>
    <svg viewBox="0 0 16 16" class="size-4 shrink-0 fill-neutral-400" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.22 10.22a.75.75 0 0 1 1.06 0L8 11.94l1.72-1.72a.75.75 0 1 1 1.06 1.06l-2.25 2.25a.75.75 0 0 1-1.06 0l-2.25-2.25a.75.75 0 0 1 0-1.06Zm5.56-4.44a.75.75 0 0 1-1.06 0L8 4.06 6.28 5.78a.75.75 0 0 1-1.06-1.06l2.25-2.25a.75.75 0 0 1 1.06 0l2.25 2.25a.75.75 0 0 1 0 1.06Z" clip-rule="evenodd"/>
    </svg>
  </summary>

  <div class="absolute <%= panel_position %> z-10 w-full rounded-lg surface p-1 shadow-lg inset-ring inset-ring-neutral-950/10 dark:shadow-none dark:inset-ring-white/10">
    <%= link_to "Account settings", account_path, class: item %>
    <%= link_to "Security", security_account_path, class: item %>
    <div class="mx-2.5 my-1 border-t border-neutral-950/5 dark:border-white/5"></div>
    <%= button_to "Sign out", logout_path, method: :delete, class: item %>
  </div>
</details>
