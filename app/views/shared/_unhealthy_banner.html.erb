<% if @unhealthy_connections.present? %>
  <div role="alert" class="mb-8 rounded-lg bg-red-50 px-4 py-3 inset-ring inset-ring-red-600/20 dark:bg-red-950/40 dark:inset-ring-red-400/25">
    <h2 class="text-sm font-semibold text-red-800 dark:text-red-200">
      <%= pluralize(@unhealthy_connections.size, "connection") %> failing delivery
    </h2>
    <ul role="list" class="mt-2 space-y-1 text-sm text-red-800 dark:text-red-200">
      <% @unhealthy_connections.each do |connection| %>
        <li>
          <span class="font-medium">
            <%= connection.source.name %>
            <span class="sr-only">to</span><span class="text-red-400" aria-hidden="true">→</span>
            <%= connection.destination.name %>
          </span>
          <span class="text-red-700 dark:text-red-300">— failing since <%= timestamp_tag(connection.unhealthy_since) %></span>
        </li>
      <% end %>
    </ul>
    <% if local_assigns.fetch(:link, true) %>
      <%= link_to "View connections →", connections_path,
            class: "mt-2 inline-block text-sm font-medium text-red-800 underline hover:no-underline dark:text-red-200" %>
    <% end %>
  </div>
<% end %>
