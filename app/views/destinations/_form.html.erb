<%= form_with model: @destination, class: "space-y-4 max-w-lg" do |f| %>
  <% if @destination.errors.any? %>
    <div class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-800">
      <ul class="list-disc list-inside">
        <% @destination.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= f.label :url, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :url, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= f.label :headers_text, "Custom headers", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <p class="text-xs text-gray-500 mb-1">One per line, as <code>Key: Value</code>. Sent on every forwarded request.</p>
    <%= f.text_area :headers_text, rows: 4, value: @destination.headers.map { |k, v| "#{k}: #{v}" }.join("\n"),
          class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm font-mono" %>
  </div>
  <%= f.submit submit_label, class: "rounded-md bg-blue-600 text-white px-3 py-1.5 text-sm hover:bg-blue-700" %>
<% end %>
