<%= form_with model: @destination, class: "space-y-4 max-w-lg" do |f| %>
  <% if @destination.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800 inset-ring inset-ring-red-600/20 dark:bg-red-950/40 dark:text-red-200 dark:inset-ring-red-400/25">
      <ul class="list-disc list-inside">
        <% @destination.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
    <%= f.text_field :name, class: ui(:input) %>
  </div>
  <div>
    <%= f.label :url, class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
    <%= f.text_field :url, class: ui(:input) %>
  </div>
  <div>
    <%= f.label :headers_text, "Custom headers", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
    <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-1">One per line, as <code>Key: Value</code>. Sent on every forwarded request.</p>
    <%= f.text_area :headers_text, rows: 4, value: @destination.headers.map { |k, v| "#{k}: #{v}" }.join("\n"),
          class: "#{ui(:input)} font-mono" %>
  </div>
  <div>
    <%= f.label :auth_type, "Authentication", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
    <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-1">Sets the <code>Authorization</code> header on every forwarded request, overriding any manual header above.</p>
    <%= f.select :auth_type, [ [ "None", "none" ], [ "Bearer token", "bearer" ], [ "Basic auth", "basic" ] ],
          { selected: @destination.auth_type || "none" },
          class: ui(:input) %>
    <div class="mt-2 space-y-2">
      <%= f.text_field :auth_token, placeholder: "Bearer token",
            class: ui(:input) %>
      <div class="flex gap-2">
        <%= f.text_field :auth_username, placeholder: "Username (basic auth)",
              class: ui(:input) %>
        <%= f.text_field :auth_password, placeholder: "Password (basic auth)",
              class: ui(:input) %>
      </div>
    </div>
  </div>
  <div>
    <%= f.label :rate_limit, "Rate limit", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
    <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-1">Caps how fast deliveries go out to this destination. Anything over the
      limit queues and is sent as slots free up — nothing is dropped. Leave blank for unlimited.</p>
    <div class="flex gap-2">
      <%= f.number_field :rate_limit, min: 1, placeholder: "Unlimited",
            class: ui(:input) %>
      <%= f.select :rate_limit_period, [ [ "per second", "second" ], [ "per minute", "minute" ] ],
            { selected: @destination.rate_limit_period || "second" },
            class: ui(:input) %>
    </div>
  </div>
  <%= f.submit submit_label, class: ui(:button_primary) %>
<% end %>
