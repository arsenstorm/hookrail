<% content_for :title, "Destinations" %>
<% delete_confirm = "Delete this destination? This also deletes its connections and delivery attempts." %>
<div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="<%= ui(:heading) %>">Destinations</h1>
    <div class="flex items-center gap-4">
      <% if can_edit? %>
        <%= link_to "New destination", new_destination_path, class: ui(:button_primary) %>
      <% end %>
    </div>
  </div>

  <div class="<%= ui(:scroller) %>">
    <div class="<%= ui(:scroller_inner) %>">
      <table class="w-full text-sm">
        <thead class="<%= ui(:table_head) %>">
          <tr>
            <th class="<%= ui(:th) %> w-full pr-6">Name</th>
            <th class="<%= ui(:th) %> w-px max-w-xs pr-6">URL</th>
            <th class="<%= ui(:th) %> w-px pr-6">Created</th>
            <th class="<%= ui(:th) %> w-px text-right"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="<%= ui(:table_body) %>">
          <% if @destinations.empty? %>
            <%= render "shared/empty_row", colspan: 4,
                  title: "No destinations yet",
                  body: "A destination is where events get delivered — an HTTPS endpoint or a local CLI session.",
                  cta_label: "New destination", cta_path: new_destination_path %>
          <% else %>
            <% @destinations.each do |destination| %>
              <tr>
                <td class="<%= ui(:td) %> w-full pr-6">
                  <%= link_to destination.name, destination_path(destination), class: "font-medium hover:text-oxblood-700 dark:hover:text-oxblood-300" %>
                </td>
                <td class="<%= ui(:td_muted) %> w-px max-w-xs pr-6">
                  <%# min-h-10 matches the sources table, whose copy button sets the row height. %>
                  <div class="flex min-h-10 items-center">
                    <% if destination.kind_cli? %>
                      <span class="<%= ui(:badge) %> <%= ui(:badge_neutral) %>">Local CLI session</span>
                    <% else %>
                      <span class="block max-w-xs min-w-0 truncate font-mono text-xs text-neutral-500 dark:text-neutral-400"
                            title="<%= destination.url %>"><%= destination.url %></span>
                    <% end %>
                  </div>
                </td>
                <td class="<%= ui(:td_muted) %> w-px pr-6"><%= timestamp_tag(destination.created_at) %></td>
                <td class="<%= ui(:td) %> w-px text-right">
                  <% if can_edit? %>
                    <div class="flex items-center justify-end gap-3">
                      <%= link_to "Edit", edit_destination_path(destination), class: ui(:link) %>
                      <%= button_to "Delete", destination_path(destination), method: :delete, class: ui(:danger_link), form: { class: "inline" }, data: { turbo_confirm: delete_confirm } %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
