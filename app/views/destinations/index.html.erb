<% content_for :title, "Destinations" %>
<div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="<%= ui(:heading) %>">Destinations</h1>
    <div class="flex items-center gap-4">
      <% if can_edit? %>
        <%= link_to "New destination", new_destination_path, class: ui(:button_primary) %>
      <% end %>
    </div>
  </div>

  <% if @destinations.empty? %>
    <p class="text-neutral-500 dark:text-neutral-400">No destinations yet.</p>
  <% else %>
    <div class="<%= ui(:scroller) %>"><div class="<%= ui(:scroller_inner) %>"><table class="w-full text-sm">
      <thead class="border-b border-neutral-950/10 text-left text-neutral-500 dark:border-white/10 dark:text-neutral-400">
        <tr>
          <th class="<%= ui(:th) %>">Name</th>
          <th class="<%= ui(:th) %>">URL</th>
          <th class="<%= ui(:th) %>">Created</th>
          <th class="<%= ui(:th) %>"></th>
        </tr>
      </thead>
      <tbody class="<%= ui(:table_body) %>">
        <% @destinations.each do |destination| %>
          <tr>
            <td class="<%= ui(:td_muted) %>">
              <%= link_to destination.name, destination_path(destination), class: ui(:link) %>
            </td>
            <td class="<%= ui(:td_muted) %>">
              <span class="text-xs text-neutral-500 dark:text-neutral-400"><%= destination.kind_cli? ? "Local CLI session" : destination.url %></span>
            </td>
            <td class="<%= ui(:td_muted) %>"><%= timestamp_tag(destination.created_at) %></td>
            <td class="<%= ui(:td_muted) %>">
              <% if can_edit? %>
                <%= link_to "Edit", edit_destination_path(destination), class: ui(:link) %>
                <%= button_to "Delete", destination_path(destination), method: :delete, class: ui(:danger_link), form: { class: "inline" }, data: { turbo_confirm: "Delete this destination? This also deletes its connections and delivery attempts." } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table></div></div>
  <% end %>
</div>
