<% content_for :title, "Destination: #{@destination.name}" %>
<div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="<%= ui(:heading) %>">Destination: <%= @destination.name %></h1>
  </div>

  <dl class="text-sm grid grid-cols-[8rem_1fr] gap-y-1">
    <dt class="text-neutral-500 dark:text-neutral-400">Name</dt><dd><%= @destination.name %></dd>
    <dt class="text-neutral-500 dark:text-neutral-400">URL</dt><dd><%= @destination.kind_cli? ? "Local CLI session" : @destination.url %></dd>
    <dt class="text-neutral-500 dark:text-neutral-400">Rate limit</dt>
    <dd><%= @destination.rate_limited? ? "#{@destination.rate_limit} per #{@destination.rate_limit_period}" : "Unlimited" %></dd>
    <dt class="text-neutral-500 dark:text-neutral-400">Created</dt><dd><%= timestamp_tag(@destination.created_at) %></dd>
  </dl>

  <section class="my-8">
    <h2 class="mb-2 text-sm font-semibold text-neutral-950 dark:text-white">Custom headers</h2>
    <% if @destination.headers.blank? %>
      <p class="text-neutral-500 dark:text-neutral-400 text-sm">None.</p>
    <% else %>
      <pre class="overflow-x-auto rounded-lg bg-neutral-950/5 p-3 text-xs text-neutral-800 dark:bg-white/5 dark:text-neutral-200"><%= @destination.headers.map { |k, v| "#{k}: #{v}" }.join("\n") %></pre>
    <% end %>
  </section>

  <%# Editors only: the JSON API deliberately never serialises this, and a
      viewer holding it could forge traffic to the receiver directly. %>
  <% if can_edit? %>
    <section class="my-8">
      <h2 class="mb-2 text-sm font-semibold text-neutral-950 dark:text-white">Signing secret</h2>
      <div class="flex gap-2 max-w-2xl">
        <input type="text" readonly id="signing-secret" value="<%= @destination.signing_secret %>"
               class="<%= ui(:input) %> bg-neutral-950/5 dark:bg-white/5">
        <button type="button" data-controller="clipboard"
                data-clipboard-text-value="<%= @destination.signing_secret %>"
                data-action="clipboard#copy"
                class="<%= ui(:button_secondary) %> whitespace-nowrap">
          <span data-clipboard-target="copy">Copy</span>
          <span data-clipboard-target="done" class="hidden">Copied</span>
        </button>
      </div>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Used to HMAC-sign forwarded payloads.</p>
    </section>
  <% end %>

  <div class="flex items-center gap-3">
    <% if can_edit? %>
      <%= link_to "Edit", edit_destination_path(@destination), class: ui(:button_secondary) %>
      <%= button_to "Rotate secret", rotate_secret_destination_path(@destination), method: :patch,
            class: ui(:button_secondary),
            form: { class: "inline" },
            data: { turbo_confirm: "Rotate the signing secret? Forwarded payloads will be signed with the new secret from now on." } %>
      <%= button_to "Delete", destination_path(@destination), method: :delete,
            class: "#{ui(:button_danger)} inset-ring inset-ring-red-600/20 dark:inset-ring-red-400/25",
            form: { class: "inline" },
            data: { turbo_confirm: "Delete this destination? This also deletes its connections and delivery attempts." } %>
    <% end %>
    <%= link_to "← Destinations", destinations_path, class: ui(:muted_link) %>
  </div>
</div>
