<% content_for :title, "Organization settings · API keys" %>
<div>
  <h1 class="<%= ui(:heading) %>">API keys</h1>
  <p class="mt-1 max-w-2xl <%= ui(:hint) %>">
    Keys authenticate against the REST API at <code>/api/v1</code>. Send one as
    <code>Authorization: Bearer &lt;key&gt;</code>.
  </p>

  <% if flash[:new_api_key] %>
    <div class="mt-6 max-w-2xl rounded-xl bg-amber-50 p-4 inset-ring inset-ring-amber-600/20 dark:bg-amber-400/10 dark:inset-ring-amber-400/25">
      <h2 class="text-sm font-semibold text-amber-900 dark:text-amber-300">Copy this key now — it will not be shown again</h2>
      <div class="mt-2 rounded-lg surface px-3 py-2 font-mono text-sm break-all select-all inset-ring inset-ring-amber-600/20 dark:inset-ring-amber-400/25">
        <%= flash[:new_api_key] %>
      </div>
      <p class="mt-2 text-sm text-amber-800 dark:text-amber-300/80">
        Only a digest is stored, so we can't show it to you again.
      </p>
    </div>
  <% end %>

  <div class="mt-6 max-w-2xl rounded-xl p-4 inset-ring inset-ring-neutral-950/10 dark:inset-ring-white/10">
    <%= form_with url: api_keys_path, scope: :api_key do |f| %>
      <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <%= f.label :name, "Key name", class: ui(:label) %>
          <%= f.text_field :name, placeholder: "CI deploy", class: "#{ui(:input)} mt-1.5" %>
        </div>
        <%= f.submit "Create key", class: ui(:button_primary) %>
      </div>
      <p class="mt-3 <%= ui(:hint) %>">Names are for you — they show up in this list and nowhere else.</p>
    <% end %>
  </div>

  <% if @api_keys.empty? %>
    <p class="mt-6 <%= ui(:hint) %>">No API keys yet.</p>
  <% else %>
    <div class="mt-6 <%= ui(:scroller) %>">
      <div class="<%= ui(:scroller_inner) %>">
        <table class="w-full text-sm">
          <thead class="<%= ui(:table_head) %>">
            <tr>
              <th class="<%= ui(:th) %> w-full pr-6">Name</th>
              <th class="<%= ui(:th) %> w-px pr-6">Key</th>
              <th class="<%= ui(:th) %> w-px pr-6">Created</th>
              <th class="<%= ui(:th) %> w-px text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="<%= ui(:table_body) %>">
            <% @api_keys.each do |api_key| %>
              <tr class="<%= "text-neutral-400 dark:text-neutral-500" unless api_key.active? %>">
                <td class="<%= ui(:td) %> w-full pr-6 font-medium"><%= api_key.name %></td>
                <td class="<%= ui(:td_muted) %> w-px pr-6 font-mono text-xs"><%= api_key.prefix %>…</td>
                <td class="<%= ui(:td_muted) %> w-px pr-6"><%= timestamp_tag(api_key.created_at) %></td>
                <td class="<%= ui(:td) %> w-px text-right">
                  <% if api_key.active? %>
                    <%= button_to "Revoke", api_key_path(api_key), method: :delete,
                          class: ui(:button_danger), form: { class: "inline" },
                          data: { turbo_confirm: "Revoke this key? Anything using it stops working immediately." } %>
                  <% else %>
                    <span class="<%= ui(:badge) %> <%= ui(:badge_neutral) %>">revoked <%= timestamp_tag(api_key.revoked_at) %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <section class="mt-10">
    <h2 class="<%= ui(:subheading) %>">CLI tokens</h2>
    <p class="mt-1 max-w-2xl <%= ui(:hint) %>">Issued by <code>hookrail login</code>, one per machine.</p>

    <% if @cli_tokens.empty? %>
      <p class="mt-4 <%= ui(:hint) %>">No CLI tokens yet.</p>
    <% else %>
      <div class="mt-4 <%= ui(:scroller) %>">
        <div class="<%= ui(:scroller_inner) %>">
          <table class="w-full text-sm">
            <thead class="<%= ui(:table_head) %>">
              <tr>
                <th class="<%= ui(:th) %> w-full pr-6">Name</th>
                <th class="<%= ui(:th) %> w-px pr-6">Token</th>
                <th class="<%= ui(:th) %> w-px pr-6">User</th>
                <th class="<%= ui(:th) %> w-px pr-6">Last used</th>
                <th class="<%= ui(:th) %> w-px text-right"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody class="<%= ui(:table_body) %>">
              <% @cli_tokens.each do |cli_token| %>
                <tr>
                  <td class="<%= ui(:td) %> w-full pr-6 font-medium"><%= cli_token.name %></td>
                  <td class="<%= ui(:td_muted) %> w-px pr-6 font-mono text-xs"><%= cli_token.prefix %>…</td>
                  <td class="<%= ui(:td_muted) %> w-px pr-6"><%= cli_token.user.github_login %></td>
                  <td class="<%= ui(:td_muted) %> w-px pr-6"><%= cli_token.last_used_at ? timestamp_tag(cli_token.last_used_at) : "never" %></td>
                  <td class="<%= ui(:td) %> w-px text-right">
                    <%= button_to "Revoke", cli_token_path(cli_token), method: :delete,
                          class: ui(:button_danger), form: { class: "inline" },
                          data: { turbo_confirm: "Revoke this CLI token? Anything using it stops working immediately." } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </section>
</div>
