<% content_for :title, "Quarantined webhook ##{@quarantined_webhook.id}" %>
<div>
  <%= link_to "← Quarantine", quarantined_webhooks_path, class: ui(:muted_link) %>
  <h1 class="text-2xl font-semibold mt-2 mb-6"><%= @quarantined_webhook.http_method %> <%= @quarantined_webhook.path %></h1>

  <section class="mb-8">
    <h2 class="mb-2 text-sm font-semibold text-neutral-950 dark:text-white">Request</h2>
    <dl class="text-sm grid grid-cols-[8rem_1fr] gap-y-1">
      <dt class="text-neutral-500 dark:text-neutral-400">Source</dt><dd><%= @quarantined_webhook.source.name %></dd>
      <dt class="text-neutral-500 dark:text-neutral-400">Method</dt><dd><%= @quarantined_webhook.http_method %></dd>
      <dt class="text-neutral-500 dark:text-neutral-400">Path</dt><dd><%= @quarantined_webhook.path %></dd>
      <dt class="text-neutral-500 dark:text-neutral-400">Query</dt><dd><%= @quarantined_webhook.query_string %></dd>
      <dt class="text-neutral-500 dark:text-neutral-400">Received</dt><dd><%= timestamp_tag(@quarantined_webhook.received_at) %></dd>
      <dt class="text-neutral-500 dark:text-neutral-400">Reason</dt><dd class="font-medium text-red-700 dark:text-red-400"><%= @quarantined_webhook.reason %></dd>
    </dl>
  </section>

  <section class="mb-8">
    <h2 class="mb-2 text-sm font-semibold text-neutral-950 dark:text-white">Headers</h2>
    <pre class="overflow-x-auto rounded-lg bg-neutral-950/5 p-3 text-xs text-neutral-800 dark:bg-white/5 dark:text-neutral-200"><%= JSON.pretty_generate(@quarantined_webhook.headers) %></pre>
  </section>

  <section>
    <h2 class="mb-2 text-sm font-semibold text-neutral-950 dark:text-white">Body</h2>
    <pre class="overflow-x-auto rounded-lg bg-neutral-950/5 p-3 text-xs text-neutral-800 dark:bg-white/5 dark:text-neutral-200"><%= @quarantined_webhook.body %></pre>
  </section>
</div>
