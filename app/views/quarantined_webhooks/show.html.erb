<% content_for :title, "Quarantined webhook ##{@quarantined_webhook.id}" %>
<div class="w-full max-w-4xl mx-auto py-16">
  <%= link_to "← Quarantine", quarantined_webhooks_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h1 class="text-2xl font-semibold mt-2 mb-6"><%= @quarantined_webhook.http_method %> <%= @quarantined_webhook.path %></h1>

  <section class="mb-8">
    <h2 class="text-sm font-semibold text-gray-500 uppercase mb-2">Request</h2>
    <dl class="text-sm grid grid-cols-[8rem_1fr] gap-y-1">
      <dt class="text-gray-500">Source</dt><dd><%= @quarantined_webhook.source.name %></dd>
      <dt class="text-gray-500">Method</dt><dd><%= @quarantined_webhook.http_method %></dd>
      <dt class="text-gray-500">Path</dt><dd><%= @quarantined_webhook.path %></dd>
      <dt class="text-gray-500">Query</dt><dd><%= @quarantined_webhook.query_string %></dd>
      <dt class="text-gray-500">Received</dt><dd><%= @quarantined_webhook.received_at.strftime("%Y-%m-%d %H:%M:%S") %></dd>
      <dt class="text-gray-500">Reason</dt><dd class="font-medium text-red-700"><%= @quarantined_webhook.reason %></dd>
    </dl>
  </section>

  <section class="mb-8">
    <h2 class="text-sm font-semibold text-gray-500 uppercase mb-2">Headers</h2>
    <pre class="bg-gray-50 rounded p-3 text-xs overflow-x-auto"><%= JSON.pretty_generate(@quarantined_webhook.headers) %></pre>
  </section>

  <section>
    <h2 class="text-sm font-semibold text-gray-500 uppercase mb-2">Body</h2>
    <pre class="bg-gray-50 rounded p-3 text-xs overflow-x-auto"><%= @quarantined_webhook.body %></pre>
  </section>
</div>
