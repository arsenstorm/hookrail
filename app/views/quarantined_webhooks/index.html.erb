<% content_for :title, "Quarantine" %>
<div class="w-full max-w-4xl mx-auto py-16">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold">Quarantine</h1>
    <%= link_to "Dashboard", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <% if @quarantined_webhooks.empty? %>
    <p class="text-gray-500">No quarantined webhooks. Requests that fail signature verification show up here.</p>
  <% else %>
    <table class="w-full text-sm">
      <thead class="text-left text-gray-500 border-b">
        <tr>
          <th class="py-2 font-medium">Received</th>
          <th class="py-2 font-medium">Source</th>
          <th class="py-2 font-medium">Method</th>
          <th class="py-2 font-medium">Reason</th>
        </tr>
      </thead>
      <tbody>
        <% @quarantined_webhooks.each do |webhook| %>
          <tr class="border-b hover:bg-gray-50">
            <td class="py-2">
              <%= link_to webhook.received_at.strftime("%Y-%m-%d %H:%M:%S"),
                    quarantined_webhook_path(webhook), class: "text-blue-600 hover:underline" %>
            </td>
            <td class="py-2"><%= webhook.source.name %></td>
            <td class="py-2"><%= webhook.http_method %></td>
            <td class="py-2 text-red-700"><%= webhook.reason %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
