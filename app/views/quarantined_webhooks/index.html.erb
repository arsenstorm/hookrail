<% content_for :title, "Quarantine" %>
<div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="<%= ui(:heading) %>">Quarantine</h1>
  </div>

  <% if @quarantined_webhooks.empty? %>
    <p class="text-neutral-500 dark:text-neutral-400">No quarantined webhooks. Requests that fail signature verification show up here.</p>
  <% else %>
    <div class="<%= ui(:scroller) %>"><div class="<%= ui(:scroller_inner) %>"><table class="w-full text-sm">
      <thead class="border-b border-neutral-950/10 text-left text-neutral-500 dark:border-white/10 dark:text-neutral-400">
        <tr>
          <th class="<%= ui(:th) %>">Received</th>
          <th class="<%= ui(:th) %>">Source</th>
          <th class="<%= ui(:th) %>">Method</th>
          <th class="<%= ui(:th) %>">Reason</th>
        </tr>
      </thead>
      <tbody class="<%= ui(:table_body) %>">
        <% @quarantined_webhooks.each do |webhook| %>
          <tr>
            <td class="<%= ui(:td_muted) %>">
              <%= link_to timestamp_tag(webhook.received_at, tabindex: nil),
                    quarantined_webhook_path(webhook), class: ui(:link) %>
            </td>
            <td class="<%= ui(:td_muted) %>"><%= webhook.source.name %></td>
            <td class="<%= ui(:td_muted) %>"><%= webhook.http_method %></td>
            <td class="py-2 text-red-700"><%= webhook.reason %></td>
          </tr>
        <% end %>
      </tbody>
    </table></div></div>
  <% end %>
</div>
