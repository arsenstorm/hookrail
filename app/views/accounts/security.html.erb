<% content_for :title, "Security" %>
<% user = current_user %>
<div class="mx-auto w-full max-w-2xl py-16">
  <div class="mb-6 flex items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold tracking-tight text-balance text-neutral-950 dark:text-white">Security</h1>
    <%= link_to "Account settings", account_path, class: "text-sm text-neutral-500 transition-colors duration-150 ease-out hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white" %>
  </div>

  <h2 class="text-sm font-semibold text-neutral-950 dark:text-white">Sign-in method</h2>
  <div class="mt-2 flex flex-wrap items-center justify-between gap-4 rounded-xl elevated px-5 py-4">
    <div class="min-w-0">
      <p class="text-sm font-medium text-neutral-950 dark:text-white">GitHub</p>
      <p class="truncate text-sm text-neutral-500 dark:text-neutral-400">Signed in as @<%= user.github_login %> · user ID <%= user.github_uid %></p>
    </div>
    <%= button_to "Sign out", logout_path, method: :delete,
          class: "shrink-0 cursor-pointer rounded-md bg-oxblood-700 px-3 py-1.5 text-sm font-medium text-white transition-colors duration-150 ease-out hover:bg-oxblood-800 dark:bg-oxblood-600 dark:hover:bg-oxblood-500" %>
  </div>
  <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
    GitHub is the only way into this account — there is no password to change. Revoking the Hookrail
    OAuth app in your GitHub settings blocks future sign-ins.
  </p>

  <h2 class="mt-10 text-sm font-semibold text-neutral-950 dark:text-white">CLI tokens</h2>
  <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
    Device credentials issued by <code class="rounded-sm bg-neutral-950/5 px-1 py-0.5 text-xs dark:bg-white/10">hookrail login</code>,
    scoped to <%= Current.organization&.name || "this organization" %>. They act as you — revoke any you don't recognise.
  </p>
  <% if @cli_tokens.any? %>
    <ul role="list" class="mt-3 divide-y divide-neutral-950/5 dark:divide-white/5">
      <% @cli_tokens.each do |token| %>
        <li class="flex items-center justify-between gap-4 py-3">
          <div class="min-w-0">
            <p class="truncate text-sm font-medium text-neutral-950 dark:text-white"><%= token.name %></p>
            <p class="truncate text-sm text-neutral-500 dark:text-neutral-400">
              <%= token.prefix %>… · <%= token.last_used_at ? "used #{time_ago_in_words(token.last_used_at)} ago" : "never used" %>
            </p>
          </div>
          <%= button_to "Revoke", cli_token_path(token), method: :delete,
                form: { data: { turbo_confirm: "Revoke #{token.name}? Any device using it stops working." } },
                class: "shrink-0 cursor-pointer rounded-md px-3 py-1.5 text-sm font-medium text-red-700 transition-colors duration-150 ease-out hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950/40" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400">
      No active tokens — run <code class="rounded-sm bg-neutral-950/5 px-1 py-0.5 text-xs dark:bg-white/10">hookrail login</code> to issue one.
    </p>
  <% end %>
</div>
