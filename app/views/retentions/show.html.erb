<% content_for :title, "Organization settings · Data retention" %>
<% organization = Current.organization %>
<div>
  <h1 class="<%= ui(:heading) %>">Data retention</h1>
  <p class="mt-1 max-w-2xl <%= ui(:hint) %>">
    One window for the whole org. Every night, events, delivery attempts, and quarantined webhooks older
    than it are deleted for good — there is no export and no undo. Metrics daily rollups are kept, so the
    charts keep their history after the raw payloads are gone, and sources, destinations, connections, and
    API keys are never touched.
  </p>

  <div class="mt-6 max-w-2xl rounded-xl p-4 inset-ring inset-ring-neutral-950/10 dark:inset-ring-white/10">
    <%= form_with model: organization, url: retention_path, method: :patch, scope: :organization do |f| %>
      <% if organization.errors.any? %>
        <div class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800 inset-ring inset-ring-red-600/20 dark:bg-red-950/40 dark:text-red-200 dark:inset-ring-red-400/25">
          <ul class="list-inside list-disc">
            <% organization.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-2">
        <% {
             7  => "Tightest window. Keep only the last week of raw traffic.",
             30 => "The default. A month of payloads to debug against.",
             90 => "Longest window. Keep a quarter of raw traffic around."
           }.each do |days, description| %>
          <label class="flex cursor-pointer items-start gap-3 rounded-lg px-3 py-2 transition-colors duration-150 inset-ring inset-ring-neutral-950/10 hover:bg-neutral-950/5 dark:inset-ring-white/10 dark:hover:bg-white/5">
            <%= f.radio_button :retention_days, days, checked: organization.retention_days_in_database == days, class: "mt-1 cursor-pointer" %>
            <span class="text-sm">
              <span class="block font-medium text-neutral-950 tabular-nums dark:text-white"><%= days %> days</span>
              <span class="block text-neutral-500 dark:text-neutral-400"><%= description %></span>
            </span>
          </label>
        <% end %>
      </div>

      <%= f.submit "Save", class: "#{ui(:button_primary)} mt-4" %>
    <% end %>
  </div>
</div>
