<% content_for :title, "Data retention" %>
<% organization = Current.organization %>
<div class="w-full max-w-4xl mx-auto py-16">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold">Data retention</h1>
    <%= link_to "Dashboard", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <p class="text-sm text-gray-600 mb-6 max-w-lg">
    One window for the whole org. Every night, events, delivery attempts, and quarantined webhooks older
    than it are deleted for good — there is no export and no undo. Metrics daily rollups are kept, so the
    charts keep their history after the raw payloads are gone, and sources, destinations, connections, and
    API keys are never touched.
  </p>

  <%= form_with model: organization, url: retention_path, method: :patch, scope: :organization,
        class: "space-y-4 max-w-lg" do |f| %>
    <% if organization.errors.any? %>
      <div class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-800">
        <ul class="list-disc list-inside">
          <% organization.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-2">
      <% {
           7  => "Tightest window. Keep only the last week of raw traffic.",
           30 => "The default. A month of payloads to debug against.",
           90 => "Longest window. Keep a quarter of raw traffic around."
         }.each do |days, description| %>
        <label class="flex items-start gap-3 rounded-md border border-gray-300 px-3 py-2 cursor-pointer hover:bg-gray-50">
          <%= f.radio_button :retention_days, days, checked: organization.retention_days_in_database == days, class: "mt-1" %>
          <span class="text-sm">
            <span class="block font-medium text-gray-900"><%= days %> days</span>
            <span class="block text-gray-500"><%= description %></span>
          </span>
        </label>
      <% end %>
    </div>

    <%= f.submit "Save", class: "rounded-md bg-blue-600 text-white px-3 py-1.5 text-sm hover:bg-blue-700 cursor-pointer" %>
  <% end %>
</div>
