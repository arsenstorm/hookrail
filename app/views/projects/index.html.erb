<% content_for :title, "Projects" %>
<div class="w-full max-w-4xl mx-auto py-16">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold">Projects</h1>
    <%= link_to "Dashboard", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <p class="text-sm text-gray-600 mb-6 max-w-lg">
    Projects partition sources, destinations, and connections — use them to separate staging from
    production. Members see only the projects they're granted on the members page.
  </p>

  <%= form_with url: projects_path, scope: :project, class: "flex gap-2 mb-8 max-w-lg" do |form| %>
    <%= form.text_field :name, placeholder: "New project name",
          class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
    <%= form.submit "Create project",
          class: "rounded-md bg-blue-600 text-white px-3 py-1.5 text-sm hover:bg-blue-700 cursor-pointer" %>
  <% end %>

  <table class="w-full text-sm">
    <thead class="text-left text-gray-500 border-b">
      <tr>
        <th class="py-2 font-medium">Name</th>
        <th class="py-2 font-medium">Created</th>
        <th class="py-2 font-medium"></th>
      </tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr class="border-b hover:bg-gray-50">
          <td class="py-2">
            <%= form_with url: project_path(project), method: :patch, scope: :project, class: "flex gap-2" do |form| %>
              <%= form.text_field :name, value: project.name,
                    class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
              <%= form.submit "Rename",
                    class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 cursor-pointer" %>
            <% end %>
          </td>
          <td class="py-2"><%= project.created_at.strftime("%Y-%m-%d") %></td>
          <td class="py-2">
            <%= button_to "Delete", project_path(project), method: :delete,
                  class: "text-red-600 hover:underline text-sm cursor-pointer",
                  data: { turbo_confirm: "Delete #{project.name}? Every source, destination, connection, event, and attempt in it is permanently deleted." } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
