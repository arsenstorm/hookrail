<% content_for :title, "Organization settings · Projects" %>
<div>
  <h1 class="<%= ui(:heading) %>">Projects</h1>
  <p class="mt-1 max-w-2xl <%= ui(:hint) %>">
    Projects partition sources, destinations, and connections — use them to separate staging from
    production. Members see only the projects they're granted on the members page.
  </p>

  <div class="mt-6 max-w-2xl rounded-xl p-4 inset-ring inset-ring-neutral-950/10 dark:inset-ring-white/10">
    <%= form_with url: projects_path, scope: :project do |form| %>
      <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <%= form.label :name, "Project name", class: ui(:label) %>
          <%= form.text_field :name, placeholder: "Staging", class: "#{ui(:input)} mt-1.5" %>
        </div>
        <%= form.submit "Create project", class: ui(:button_primary) %>
      </div>
      <p class="mt-3 <%= ui(:hint) %>">Names are unique within the organization.</p>
    <% end %>
  </div>

  <div class="mt-6 <%= ui(:scroller) %>">
    <div class="<%= ui(:scroller_inner) %>">
      <table class="w-full text-sm">
        <thead class="<%= ui(:table_head) %>">
          <tr>
            <th class="<%= ui(:th) %> w-full pr-6">Name</th>
            <th class="<%= ui(:th) %> w-px pr-6">Created</th>
            <th class="<%= ui(:th) %> w-px text-right"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="<%= ui(:table_body) %>">
          <% @projects.each do |project| %>
            <tr>
              <td class="<%= ui(:td) %> w-full pr-6">
                <%= form_with url: project_path(project), method: :patch, scope: :project, class: "flex max-w-sm gap-2" do |form| %>
                  <%# Unique id per row: the rename field repeats down the table. %>
                  <%= form.label :name, "Name", for: "project-name-#{project.id}", class: "sr-only" %>
                  <%= form.text_field :name, value: project.name, id: "project-name-#{project.id}", class: ui(:input) %>
                  <%= form.submit "Rename", class: ui(:button_secondary) %>
                <% end %>
              </td>
              <td class="<%= ui(:td_muted) %> w-px pr-6"><%= timestamp_tag(project.created_at) %></td>
              <td class="<%= ui(:td) %> w-px text-right">
                <%= button_to "Delete", project_path(project), method: :delete,
                      class: ui(:button_danger), form: { class: "inline" },
                      data: { turbo_confirm: "Delete #{project.name}? Every source, destination, connection, event, and attempt in it is permanently deleted." } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
