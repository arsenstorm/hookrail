<% content_for :title, "New connection" %>
<div class="w-full max-w-4xl mx-auto py-16">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold">New connection</h1>
    <%= link_to "Dashboard", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <% if @sources.empty? || @destinations.empty? %>
    <p class="text-gray-600 text-sm mb-4">You need at least one source and one destination first.</p>
    <div class="flex gap-4">
      <%= link_to "Create a source →", new_source_path, class: "text-blue-600 hover:underline" %>
      <%= link_to "Create a destination →", new_destination_path, class: "text-blue-600 hover:underline" %>
    </div>
  <% else %>
    <%= form_with model: @connection, class: "space-y-4 max-w-md" do |f| %>
      <% if @connection.errors.any? %>
        <div class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-800">
          <ul class="list-disc list-inside">
            <% @connection.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
          </ul>
        </div>
      <% end %>
      <div>
        <%= f.label :source_id, "Source", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :source_id, @sources, :id, :name, {}, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :destination_id, "Destination", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :destination_id, @destinations, :id, :name, {}, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <%= f.submit "Create connection", class: "rounded-md bg-blue-600 text-white px-3 py-1.5 text-sm hover:bg-blue-700" %>
    <% end %>
  <% end %>

  <%= link_to "← Connections", connections_path, class: "text-sm text-gray-500 hover:text-gray-700 mt-4 inline-block" %>
</div>
