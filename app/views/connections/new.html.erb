<% content_for :title, "New connection" %>
<div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="<%= ui(:heading) %>">New connection</h1>
  </div>

  <% if @sources.empty? || @destinations.empty? %>
    <p class="text-neutral-600 dark:text-neutral-400 text-sm mb-4">You need at least one source and one destination first.</p>
    <div class="flex gap-4">
      <%= link_to "Create a source →", new_source_path, class: ui(:link) %>
      <%= link_to "Create a destination →", new_destination_path, class: ui(:link) %>
    </div>
  <% else %>
    <%= form_with model: @connection, class: "space-y-4 max-w-md" do |f| %>
      <% if @connection.errors.any? %>
        <div class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800 inset-ring inset-ring-red-600/20 dark:bg-red-950/40 dark:text-red-200 dark:inset-ring-red-400/25">
          <ul class="list-disc list-inside">
            <% @connection.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
          </ul>
        </div>
      <% end %>
      <div>
        <%= f.label :source_id, "Source", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
        <%= f.collection_select :source_id, @sources, :id, :name, {}, class: ui(:input) %>
      </div>
      <div>
        <%= f.label :destination_id, "Destination", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
        <%= f.collection_select :destination_id, @destinations, :id, :name, {}, class: ui(:input) %>
      </div>
      <%= f.submit "Create connection", class: ui(:button_primary) %>
    <% end %>
  <% end %>

  <%= link_to "← Connections", connections_path, class: "#{ui(:muted_link)} mt-4 inline-block" %>
</div>
