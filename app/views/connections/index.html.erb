<% content_for :title, "Connections" %>
<div class="w-full max-w-4xl mx-auto py-16">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold">Connections</h1>
    <div class="flex items-center gap-4">
      <%= link_to "New connection", new_connection_path, class: "text-blue-600 hover:underline" %>
      <%= link_to "Dashboard", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
  </div>

  <%= render "shared/unhealthy_banner", link: false %>

  <% if @connections.empty? %>
    <p class="text-gray-500">No connections yet.</p>
  <% else %>
    <table class="w-full text-sm">
      <thead class="text-left text-gray-500 border-b">
        <tr>
          <th class="py-2 font-medium">Route</th>
          <th class="py-2 font-medium">Status</th>
          <th class="py-2 font-medium">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @connections.each do |connection| %>
          <tr class="border-b hover:bg-gray-50">
            <td class="py-2">
              <%= connection.source.name %> <span class="text-gray-400">→</span> <%= connection.destination.name %>
              <% if connection.routing_rule.present? %>
                <span class="ml-1 rounded-full bg-gray-100 text-gray-600 px-2 py-0.5 text-xs">filtered</span>
              <% end %>
            </td>
            <td class="py-2">
              <% if connection.status_active? %>
                <span class="text-green-700">active</span>
              <% elsif connection.status_paused? %>
                <span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5 text-xs">paused</span>
              <% else %>
                <span class="text-gray-400">disabled</span>
              <% end %>
              <% if connection.unhealthy? %>
                <div class="mt-1 flex items-center gap-1.5">
                  <span class="rounded-full bg-red-100 text-red-800 px-2 py-0.5 text-xs">unhealthy</span>
                  <span class="text-xs text-red-700">failing for <%= time_ago_in_words(connection.unhealthy_since) %></span>
                </div>
              <% end %>
            </td>
            <td class="py-2">
              <%= link_to "Edit", edit_connection_path(connection), class: "text-blue-600 hover:underline text-sm" %>
              <% if connection.status_active? %>
                <%= button_to "Pause", status_connection_path(connection), method: :patch, params: { status: "paused" },
                      class: "text-blue-600 hover:underline text-sm", form: { class: "inline" } %>
              <% elsif connection.status_paused? %>
                <%= button_to "Resume", status_connection_path(connection), method: :patch, params: { status: "active" },
                      class: "text-blue-600 hover:underline text-sm", form: { class: "inline" } %>
              <% end %>
              <% if connection.status_disabled? %>
                <%= button_to "Enable", status_connection_path(connection), method: :patch, params: { status: "active" },
                      class: "text-blue-600 hover:underline text-sm", form: { class: "inline" } %>
              <% else %>
                <%= button_to "Disable", status_connection_path(connection), method: :patch, params: { status: "disabled" },
                      class: "text-blue-600 hover:underline text-sm", form: { class: "inline" },
                      data: { turbo_confirm: "Disable this connection? Held and pending deliveries are cancelled." } %>
              <% end %>
              <%= button_to "Delete", connection_path(connection), method: :delete,
                    class: "text-red-600 hover:underline text-sm", form: { class: "inline" },
                    data: { turbo_confirm: "Delete this connection? This also deletes its delivery attempts." } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
