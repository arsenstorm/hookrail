<% content_for :title, "Connections" %>
<div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="<%= ui(:heading) %>">Connections</h1>
    <div class="flex items-center gap-4">
      <% if can_edit? %>
        <%= link_to "New connection", new_connection_path, class: ui(:button_primary) %>
      <% end %>
    </div>
  </div>

  <%= render "shared/unhealthy_banner", link: false %>

  <% if @connections.empty? %>
    <p class="text-neutral-500 dark:text-neutral-400">No connections yet.</p>
  <% else %>
    <div class="<%= ui(:scroller) %>"><div class="<%= ui(:scroller_inner) %>"><table class="w-full text-sm">
      <thead class="border-b border-neutral-950/10 text-left text-neutral-500 dark:border-white/10 dark:text-neutral-400">
        <tr>
          <th class="<%= ui(:th) %>">Route</th>
          <th class="<%= ui(:th) %>">Status</th>
          <th class="<%= ui(:th) %>">Actions</th>
        </tr>
      </thead>
      <tbody class="<%= ui(:table_body) %>">
        <% @connections.each do |connection| %>
          <tr>
            <td class="<%= ui(:td_muted) %>">
              <%= connection.source.name %> <span class="text-neutral-400 dark:text-neutral-500">→</span> <%= connection.destination.name %>
              <% if connection.routing_rule.present? %>
                <span class="ml-1 rounded-full bg-neutral-950/5 dark:bg-white/5 text-neutral-600 dark:text-neutral-400 px-2 py-0.5 text-xs">filtered</span>
              <% end %>
            </td>
            <td class="<%= ui(:td_muted) %>">
              <% if connection.status_active? %>
                <span class="text-green-700">active</span>
              <% elsif connection.status_paused? %>
                <span class="rounded-full bg-amber-100 text-amber-800 px-2 py-0.5 text-xs">paused</span>
              <% else %>
                <span class="text-neutral-400 dark:text-neutral-500">disabled</span>
              <% end %>
              <% if connection.unhealthy? %>
                <div class="mt-1 flex items-center gap-1.5">
                  <span class="rounded-full bg-red-100 text-red-800 px-2 py-0.5 text-xs">unhealthy</span>
                  <span class="text-xs text-red-700">failing since <%= timestamp_tag(connection.unhealthy_since) %></span>
                </div>
              <% end %>
            </td>
            <td class="<%= ui(:td_muted) %>">
              <% if can_edit? %>
                <%= link_to "Edit", edit_connection_path(connection), class: "#{ui(:link)} text-sm" %>
                <% if connection.status_active? %>
                  <%= button_to "Pause", status_connection_path(connection), method: :patch, params: { status: "paused" },
                        class: "#{ui(:link)} text-sm", form: { class: "inline" } %>
                <% elsif connection.status_paused? %>
                  <%= button_to "Resume", status_connection_path(connection), method: :patch, params: { status: "active" },
                        class: "#{ui(:link)} text-sm", form: { class: "inline" } %>
                <% end %>
                <% if connection.status_disabled? %>
                  <%= button_to "Enable", status_connection_path(connection), method: :patch, params: { status: "active" },
                        class: "#{ui(:link)} text-sm", form: { class: "inline" } %>
                <% else %>
                  <%= button_to "Disable", status_connection_path(connection), method: :patch, params: { status: "disabled" },
                        class: "#{ui(:link)} text-sm", form: { class: "inline" },
                        data: { turbo_confirm: "Disable this connection? Held and pending deliveries are cancelled." } %>
                <% end %>
                <%= button_to "Delete", connection_path(connection), method: :delete,
                      class: ui(:danger_link), form: { class: "inline" },
                      data: { turbo_confirm: "Delete this connection? This also deletes its delivery attempts." } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table></div></div>
  <% end %>
</div>
