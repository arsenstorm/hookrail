<%= form_with model: @source, class: "space-y-4 max-w-md" do |f| %>
  <% if @source.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800 inset-ring inset-ring-red-600/20 dark:bg-red-950/40 dark:text-red-200 dark:inset-ring-red-400/25">
      <ul class="list-disc list-inside">
        <% @source.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
    <%= f.text_field :name, class: ui(:input) %>
  </div>
  <section class="border-t pt-4 space-y-4">
    <div>
      <h2 class="text-sm font-semibold text-neutral-950 dark:text-white">Inbound verification</h2>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
        Optional HMAC signature check on incoming webhooks. Leave the secret blank to disable verification
        and accept every request.
      </p>
    </div>

    <div>
      <%= f.label :verification_provider, "Provider", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.select :verification_provider, [ [ "Generic (configure below)", "" ], [ "Stripe", "stripe" ] ], {},
            class: ui(:input) %>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">A provider preset needs only the signing secret — every field below is filled in automatically and kept in sync. Switching back to generic keeps the values for editing.</p>
    </div>

    <div>
      <%= f.label :verification_secret, "Signing secret", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.text_field :verification_secret, class: ui(:input) %>
    </div>

    <div>
      <%= f.label :verification_header, "Signature header", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.text_field :verification_header, class: ui(:input) %>
    </div>

    <div>
      <%= f.label :verification_algorithm, "Algorithm", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.select :verification_algorithm, %w[sha256 sha1 sha512], {},
            class: ui(:input) %>
    </div>

    <div>
      <%= f.label :verification_encoding, "Encoding", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.select :verification_encoding, %w[hex base64], {},
            class: ui(:input) %>
    </div>

    <div>
      <%= f.label :verification_header_format, "Header format", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.select :verification_header_format,
            [ [ "Entire header value", "value" ], [ "Comma-separated key=value pairs", "kv" ] ], {},
            class: ui(:input) %>
    </div>

    <div>
      <%= f.label :verification_signature_prefix, "Signature prefix", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.text_field :verification_signature_prefix, placeholder: "sha256=",
            class: ui(:input) %>
    </div>

    <div>
      <%= f.label :verification_signature_key, "Signature key", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.text_field :verification_signature_key, placeholder: "v1",
            class: ui(:input) %>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Only used when the header format is key=value pairs.</p>
    </div>

    <div>
      <%= f.label :verification_timestamp_key, "Timestamp key", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.text_field :verification_timestamp_key, placeholder: "t",
            class: ui(:input) %>
    </div>

    <div>
      <%= f.label :verification_timestamp_header, "Timestamp header", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.text_field :verification_timestamp_header,
            class: ui(:input) %>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Use when the timestamp arrives in its own header instead of the signature header.</p>
    </div>

    <div>
      <%= f.label :verification_payload_template, "Payload template", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.text_field :verification_payload_template, placeholder: "{body}",
            class: ui(:input) %>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">What gets signed. <code>{body}</code> for the raw body, or <code>{timestamp}.{body}</code> to bind the timestamp.</p>
    </div>

    <div>
      <%= f.label :verification_tolerance_seconds, "Tolerance (seconds)", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.number_field :verification_tolerance_seconds,
            class: ui(:input) %>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Reject requests whose timestamp is older than this. Blank means no timestamp check.</p>
    </div>

    <details class="text-xs text-neutral-600 dark:text-neutral-400">
      <summary class="cursor-pointer text-neutral-500 dark:text-neutral-400">Example configurations</summary>
      <div class="mt-2 space-y-3">
        <div>
          <div class="font-medium text-neutral-700 dark:text-neutral-300">Signature in the whole header value</div>
          <p>Header <code>X-Hub-Signature-256</code>, format "Entire header value", prefix <code>sha256=</code>,
             algorithm sha256, encoding hex, payload <code>{body}</code>.</p>
        </div>
        <div>
          <div class="font-medium text-neutral-700 dark:text-neutral-300">Signature in key=value pairs</div>
          <p>Header <code>Stripe-Signature</code>, format "Comma-separated key=value pairs", signature key <code>v1</code>,
             timestamp key <code>t</code>, algorithm sha256, encoding hex, payload <code>{timestamp}.{body}</code>,
             tolerance <code>300</code>.</p>
        </div>
      </div>
    </details>
  </section>

  <section class="border-t pt-4 space-y-4">
    <div>
      <h2 class="text-sm font-semibold text-neutral-950 dark:text-white">Deduplication</h2>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
        Optional. Drops repeats of the same event inside a time window. Leave the window blank to disable
        deduplication and deliver every request.
      </p>
    </div>

    <div>
      <%= f.label :dedupe_window, "Dedupe window (seconds)", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.number_field :dedupe_window, min: 1, max: 86400, placeholder: "Off",
            class: ui(:input) %>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Blank disables deduplication. Repeats of the same event within this window are marked duplicates and never delivered.</p>
    </div>

    <div>
      <%= f.label :dedupe_key, "Identity key", class: "block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1" %>
      <%= f.text_field :dedupe_key, placeholder: "X-GitHub-Delivery",
            class: ui(:input) %>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">What makes two events the same: a header name, e.g. <code>X-GitHub-Delivery</code>, or a body path in dot syntax, e.g. <code>data.object.id</code>. Headers are checked first. Blank compares the SHA-256 of the raw body.</p>
    </div>
  </section>

  <%= f.submit submit_label, class: ui(:button_primary) %>
<% end %>
