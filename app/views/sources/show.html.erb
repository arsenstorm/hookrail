<% content_for :title, "Source: #{@source.name}" %>
<div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="<%= ui(:heading) %>">Source: <%= @source.name %></h1>
  </div>

  <dl class="text-sm grid grid-cols-[8rem_1fr] gap-y-1">
    <dt class="text-neutral-500 dark:text-neutral-400">Name</dt><dd><%= @source.name %></dd>
    <dt class="text-neutral-500 dark:text-neutral-400">Created</dt><dd><%= timestamp_tag(@source.created_at) %></dd>
    <dt class="text-neutral-500 dark:text-neutral-400">Verification</dt>
    <dd>
      <% if @source.verification_enabled? %>
        Enabled (<%= @source.verification_header.presence || "no header set" %>)
      <% else %>
        Disabled
      <% end %>
    </dd>
    <dt class="text-neutral-500 dark:text-neutral-400">Dedupe</dt>
    <dd>
      <% if @source.dedupe_enabled? %>
        Enabled (<%= @source.dedupe_window %>s window,
        <%= @source.dedupe_key.present? ? "key #{@source.dedupe_key}" : "body hash" %>)
      <% else %>
        Disabled
      <% end %>
    </dd>
    <dt class="text-neutral-500 dark:text-neutral-400">Quarantine</dt>
    <dd>
      <% count = @source.quarantined_webhooks.count %>
      <%= link_to quarantined_webhooks_path, class: ui(:link) do %>
        Quarantine
        <% if count.positive? %>
          <span class="ml-1 rounded-full bg-red-100 text-red-800 px-2 py-0.5 text-xs"><%= count %></span>
        <% else %>
          (0)
        <% end %>
      <% end %>
    </dd>
  </dl>

  <section class="my-8">
    <h2 class="mb-2 text-sm font-semibold text-neutral-950 dark:text-white">Ingest URL</h2>
    <div class="flex gap-2 max-w-2xl">
      <input type="text" readonly id="ingest-url" value="<%= ingest_url(token: @source.token) %>"
             class="<%= ui(:input) %> bg-neutral-950/5 dark:bg-white/5">
      <button type="button" data-controller="clipboard"
              data-clipboard-text-value="<%= ingest_url(token: @source.token) %>"
              data-action="clipboard#copy"
              class="<%= ui(:button_secondary) %> whitespace-nowrap">
        <span data-clipboard-target="copy">Copy</span>
        <span data-clipboard-target="done" class="hidden">Copied</span>
      </button>
    </div>
    <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">POST webhooks here. Rotating the token invalidates this URL.</p>
  </section>

  <div class="flex items-center gap-3">
    <% if can_edit? %>
      <%= link_to "Edit", edit_source_path(@source), class: ui(:button_secondary) %>
      <%= button_to "Rotate token", rotate_token_source_path(@source), method: :patch,
            class: ui(:button_secondary),
            form: { class: "inline" },
            data: { turbo_confirm: "Rotate the ingest token? The current URL will stop working immediately." } %>
      <%= button_to "Delete", source_path(@source), method: :delete,
            class: "#{ui(:button_danger)} inset-ring inset-ring-red-600/20 dark:inset-ring-red-400/25",
            form: { class: "inline" },
            data: { turbo_confirm: "Delete this source? This also deletes all its events and delivery attempts." } %>
    <% end %>
    <%= link_to "← Sources", sources_path, class: ui(:muted_link) %>
  </div>
</div>
