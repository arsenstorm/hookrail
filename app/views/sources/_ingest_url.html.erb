<%# Click-to-copy ingest URL. %>
<% url = ingest_url(token: source.token) %>
<button type="button" data-controller="clipboard" data-clipboard-text-value="<%= url %>"
        data-action="clipboard#copy" aria-label="Copy ingest URL for <%= source.name %>"
        class="ease-out-quart flex min-h-10 max-w-full cursor-pointer items-center gap-2 rounded-md px-2 py-1 -ml-2 text-left transition-[background-color] duration-150 hover:bg-neutral-950/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950/40 motion-reduce:transition-none dark:hover:bg-white/5 dark:focus-visible:outline-white/40">
  <span class="truncate font-mono text-xs text-neutral-500 dark:text-neutral-400"><%= url %></span>
  <svg data-clipboard-target="copy" viewBox="0 0 16 16" class="size-4 shrink-0 fill-current text-neutral-400 dark:text-neutral-500" aria-hidden="true">
    <path d="M5 3.5A1.5 1.5 0 0 1 6.5 2h5A1.5 1.5 0 0 1 13 3.5v6a1.5 1.5 0 0 1-1.5 1.5H11V6.5A1.5 1.5 0 0 0 9.5 5H5V3.5Z"/>
    <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h5A1.5 1.5 0 0 1 11 6.5v6A1.5 1.5 0 0 1 9.5 14h-5A1.5 1.5 0 0 1 3 12.5v-6Z"/>
  </svg>
  <svg data-clipboard-target="done" viewBox="0 0 16 16" class="hidden size-4 shrink-0 fill-current text-emerald-600 dark:text-emerald-400" aria-hidden="true">
    <path d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z"/>
  </svg>
</button>
