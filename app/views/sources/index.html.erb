<% content_for :title, "Sources" %>
<div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="<%= ui(:heading) %>">Sources</h1>
    <div class="flex items-center gap-4">
      <% if can_edit? %>
        <%= link_to "New source", new_source_path, class: ui(:button_primary) %>
      <% end %>
    </div>
  </div>

  <% if @sources.empty? %>
    <p class="text-neutral-500 dark:text-neutral-400">No sources yet.</p>
  <% else %>
    <div class="<%= ui(:scroller) %>"><div class="<%= ui(:scroller_inner) %>"><table class="w-full text-sm">
      <thead class="border-b border-neutral-950/10 text-left text-neutral-500 dark:border-white/10 dark:text-neutral-400">
        <tr>
          <th class="<%= ui(:th) %>">Name</th>
          <th class="<%= ui(:th) %>">Ingest URL</th>
          <th class="<%= ui(:th) %>">Created</th>
          <th class="<%= ui(:th) %>"></th>
        </tr>
      </thead>
      <tbody class="<%= ui(:table_body) %>">
        <% @sources.each do |source| %>
          <tr>
            <td class="<%= ui(:td_muted) %>">
              <%= link_to source.name, source_path(source), class: ui(:link) %>
            </td>
            <td class="<%= ui(:td_muted) %>">
              <span class="text-xs text-neutral-500 dark:text-neutral-400"><%= ingest_url(token: source.token) %></span>
            </td>
            <td class="<%= ui(:td_muted) %>"><%= timestamp_tag(source.created_at) %></td>
            <td class="<%= ui(:td_muted) %>">
              <% if can_edit? %>
                <%= link_to "Edit", edit_source_path(source), class: ui(:link) %>
                <%= button_to "Delete", source_path(source), method: :delete, class: ui(:danger_link), form: { class: "inline" }, data: { turbo_confirm: "Delete this source? This also deletes all its events and delivery attempts." } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table></div></div>
  <% end %>
</div>
