<% content_for :title, "Sources" %>
<% delete_confirm = "Delete this source? This also deletes all its events and delivery attempts." %>
<div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="<%= ui(:heading) %>">Sources</h1>
    <div class="flex items-center gap-4">
      <% if can_edit? %>
        <%= link_to "New source", new_source_path, class: ui(:button_primary) %>
      <% end %>
    </div>
  </div>

  <% if @sources.empty? %>
    <%= render "shared/empty_state", title: "No sources yet",
          body: "A source gives you an ingest URL that accepts webhooks from a provider.",
          cta_label: "New source", cta_path: new_source_path %>
  <% else %>
    <div class="<%= ui(:scroller) %>">
      <div class="<%= ui(:scroller_inner) %>">
        <table class="w-full text-sm">
          <thead class="<%= ui(:table_head) %>">
            <tr>
              <th class="<%= ui(:th) %> w-full pr-6">Name</th>
              <th class="<%= ui(:th) %> w-px pr-6">Ingest URL</th>
              <th class="<%= ui(:th) %> w-px pr-6">Created</th>
              <th class="<%= ui(:th) %> w-px text-right"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="<%= ui(:table_body) %>">
            <% @sources.each do |source| %>
              <tr>
                <td class="<%= ui(:td) %> w-full pr-6">
                  <%= link_to source.name, source_path(source), class: "font-medium hover:text-oxblood-700 dark:hover:text-oxblood-300" %>
                </td>
                <td class="<%= ui(:td_muted) %> w-px max-w-xs pr-6">
                  <%= render "ingest_url", source: source %>
                </td>
                <td class="<%= ui(:td_muted) %> w-px pr-6"><%= timestamp_tag(source.created_at) %></td>
                <td class="<%= ui(:td) %> w-px text-right">
                  <% if can_edit? %>
                    <div class="flex items-center justify-end gap-3">
                      <%= link_to "Edit", edit_source_path(source), class: ui(:link) %>
                      <%= button_to "Delete", source_path(source), method: :delete, class: ui(:danger_link), form: { class: "inline" }, data: { turbo_confirm: delete_confirm } %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
