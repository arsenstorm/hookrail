<% content_for :title, "Sources" %>
<div class="w-full max-w-4xl mx-auto py-16">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold">Sources</h1>
    <div class="flex items-center gap-4">
      <% if can_edit? %>
        <%= link_to "New source", new_source_path, class: "text-blue-600 hover:underline" %>
      <% end %>
      <%= link_to "Dashboard", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
  </div>

  <% if @sources.empty? %>
    <p class="text-gray-500">No sources yet.</p>
  <% else %>
    <table class="w-full text-sm">
      <thead class="text-left text-gray-500 border-b">
        <tr>
          <th class="py-2 font-medium">Name</th>
          <th class="py-2 font-medium">Ingest URL</th>
          <th class="py-2 font-medium">Created</th>
          <th class="py-2 font-medium"></th>
        </tr>
      </thead>
      <tbody>
        <% @sources.each do |source| %>
          <tr class="border-b hover:bg-gray-50">
            <td class="py-2">
              <%= link_to source.name, source_path(source), class: "text-blue-600 hover:underline" %>
            </td>
            <td class="py-2">
              <span class="text-xs text-gray-500"><%= ingest_url(token: source.token) %></span>
            </td>
            <td class="py-2"><%= source.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="py-2">
              <% if can_edit? %>
                <%= link_to "Edit", edit_source_path(source), class: "text-blue-600 hover:underline" %>
                <%= button_to "Delete", source_path(source), method: :delete, class: "text-red-600 hover:underline text-sm", form: { class: "inline" }, data: { turbo_confirm: "Delete this source? This also deletes all its events and delivery attempts." } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
