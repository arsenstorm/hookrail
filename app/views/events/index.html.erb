<% content_for :title, "Events" %>
<div class="w-full max-w-4xl mx-auto py-16">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold">Events</h1>
    <%= link_to "Dashboard", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <%= form_with url: events_path, method: :get, class: "flex flex-wrap items-end gap-3 mb-6" do |f| %>
    <div class="flex flex-col">
      <label class="text-xs text-gray-500 mb-1">Source</label>
      <%= f.select :source_id,
            options_for_select(@sources.map { |s| [ s.name, s.id ] }, @source_id),
            { include_blank: "All sources" },
            class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
    </div>
    <div class="flex flex-col">
      <label class="text-xs text-gray-500 mb-1">Status</label>
      <%= f.select :status,
            options_for_select(Event::DELIVERY_STATUSES.map { |s| [ s.capitalize, s ] }, @status),
            { include_blank: "Any status" },
            class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
    </div>
    <div class="flex flex-col">
      <label class="text-xs text-gray-500 mb-1">From</label>
      <%= f.date_field :from, value: @from, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
    </div>
    <div class="flex flex-col">
      <label class="text-xs text-gray-500 mb-1">To</label>
      <%= f.date_field :to, value: @to, class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm" %>
    </div>
    <div class="flex flex-col grow">
      <label class="text-xs text-gray-500 mb-1">Body search</label>
      <%= f.text_field :q, value: @q, placeholder: "substring…",
            class: "rounded-md border border-gray-300 px-2 py-1.5 text-sm w-full" %>
    </div>
    <%= f.submit "Filter", name: nil,
          class: "rounded-md bg-blue-600 text-white px-3 py-1.5 text-sm hover:bg-blue-700 cursor-pointer" %>
    <% if @filters_active %>
      <%= link_to "Clear", events_path, class: "px-3 py-1.5 text-sm text-gray-500 hover:text-gray-700" %>
    <% end %>
  <% end %>

  <% if @retryable_count > 0 %>
    <div class="mb-6">
      <%= button_to "Retry #{pluralize(@retryable_count, "failed delivery")}", bulk_retry_events_path(@filter_params), method: :post,
            class: "rounded-md border border-red-300 text-red-700 px-3 py-1.5 text-sm hover:bg-red-50 cursor-pointer",
            data: { turbo_confirm: "Retry #{pluralize(@retryable_count, "failed delivery")} matching the current filters?" } %>
    </div>
  <% end %>

  <% if @events.empty? %>
    <% if @filters_active %>
      <p class="text-gray-500">No events match these filters.
        <%= link_to "Clear filters", events_path, class: "text-blue-600 hover:underline" %>.
      </p>
    <% else %>
      <p class="text-gray-500">No events yet.</p>
    <% end %>
  <% else %>
    <table class="w-full text-sm">
      <thead class="text-left text-gray-500 border-b">
        <tr>
          <th class="py-2 font-medium">Received</th>
          <th class="py-2 font-medium">Method</th>
          <th class="py-2 font-medium">Source</th>
          <th class="py-2 font-medium">Delivery</th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr class="border-b hover:bg-gray-50">
            <td class="py-2">
              <%= link_to event.received_at.strftime("%Y-%m-%d %H:%M:%S"), event_path(event), class: "text-blue-600 hover:underline" %>
            </td>
            <td class="py-2"><%= event.http_method %></td>
            <td class="py-2"><%= event.source.name %></td>
            <td class="py-2"><%= delivery_summary(event) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%# ponytail: forward-only cursor. "Newest" + browser-back cover "prev"; add a prev-cursor stack only if operators ask. %>
    <div class="flex items-center justify-between mt-4">
      <%= link_to "← Newest", events_path(@filter_params), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <% if @next_cursor %>
        <%= link_to "Next →", events_path(@filter_params.merge(cursor: @next_cursor)), class: "text-sm text-blue-600 hover:underline" %>
      <% end %>
    </div>
  <% end %>
</div>
